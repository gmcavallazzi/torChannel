# TorChannel .gitignore

# Exclude specific directories
matlab/
.susa/
.fortran/
.claude/
.pytest_cache/

# Config files
# NOTE: anchored to the repo root on purpose. An unanchored "config.yaml"
# matches at ANY depth, which silently excluded examples/*/config.yaml.
/config.yaml
/config_sharma_validation.yaml

# Legacy IBM files (removed feature); the RKPM canopy IBM IS tracked
*cylinder*
*sphere*

# Local figures (untracked by design)
figures_local/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter Notebooks
.ipynb_checkpoints
*.ipynb

# Results and output
results*/
BACKUP*/
*.npz
*.csv
*.png
*.pdf
timeseries.csv
timeseries.npz

# Exceptions: shipped data. These are small, curated and belong in the repo --
# validation statistics and figures, and the digitised reference DNS profiles.
!validation/
!validation/**/*.npz
!validation/**/*.png
!validation/**/*.pdf
!torchannel/data/**/*.csv

# Log files
*.log
*.out
*.err

# Temporary files
*.tmp
temp/
tmp/

# HPC job files
*.o[0-9]*
*.e[0-9]*
slurm-*.out

# Large data files
*.h5
*.hdf5

# Configuration backups
config.yaml.bak
*.yaml.bak
